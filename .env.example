# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na Vercel.
# Nada aqui é segredo: os valores reais NUNCA entram no repositório.

# URL pública do site, sem barra no fim (canonical, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://quarkions.com

# Supabase — projeto da Quarkions
NEXT_PUBLIC_SUPABASE_URL=
# SECRETA. Só no servidor. Nunca usar com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: e-mail de notificação a cada pedido de diagnóstico (Resend)
RESEND_API_KEY=
EMAIL_NOTIFICACAO=
# Remetente verificado no Resend (padrão: onboarding@resend.dev, só para testes)
RESEND_FROM=

# Google Tag Manager: carregado só depois do "Aceitar" no aviso de cookies.
# GA4 e Meta Pixel ficam configurados DENTRO do contêiner (nada deles no código).
NEXT_PUBLIC_GTM_ID=GTM-WWNNVG88

# Meta — API de Conversões (Lead pelo servidor). Tudo só no servidor, sem NEXT_PUBLIC_.
META_PIXEL_ID=1871748183699363
# SECRETO.
META_CAPI_TOKEN=
# Usar a versão atual da Graph API, conforme a documentação da Meta (ex.: v23.0)
META_GRAPH_VERSION=
# Só para testes no Gerenciador de Eventos (Testar eventos). Deixar vazio em produção.
META_TEST_EVENT_CODE=
